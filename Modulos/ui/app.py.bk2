import streamlit as st
from PIL import Image
from Modulos.auth.auth import registrar_usuario, autenticar_usuario
from streamlit_toggle import st_toggle_switch

# --------------------------------------------------
# Página de Login
# --------------------------------------------------
def cambiar_tema(tema: str) -> None:
    """
    Aplica estilos CSS globales para los modos 'light' y 'dark'.
    """
    if tema == "dark":
        # Fondo oscuro y texto blanco
        st.markdown(
            """
            <style>
            .stApp, .stApp * {
                background-color: #2E2E2E !important;
                color: #FFFFFF !important;
            }
            .stButton>button, .stTextInput>div>div>input {
                background-color: #444444 !important;
                color: #FFFFFF !important;
                border: 20px solid #555555 !important;
            }
            </style>
            """, unsafe_allow_html=True
        )
    else:
        # Fondo claro y texto negro
        st.markdown(
            """
            <style>
            .stApp, .stApp * {
                background-color: #FFFFFF !important;
                color: #000000 !important;
            }
            .stButton>button, .stTextInput>div>div>input {
                background-color: #FFFFFF !important;
                color: #000000 !important;
                border: 2px solid #cccccc !important;
            }
            </style>
            """, unsafe_allow_html=True
        )

# --------------------------------------------------
# Página de Login
# --------------------------------------------------
def pagina_login(questions=None) -> None:
    # Asegurar tema inicial
    if "theme" not in st.session_state:
        st.session_state.theme = "light"
    cambiar_tema(st.session_state.theme)

    # Layout: formulario a la izquierda, imagen + toggle a la derecha
    col1, col2 = st.columns([2, 3])

    with col1:
        # Logo y título alineados
        logo_col, title_col = st.columns([1, 4])
        with logo_col:
            logo = Image.open("Modulos/ui/src/Mascota.png")
            st.image(logo, width=40)
        with title_col:
            st.markdown("<h1 style='margin-top: 0;'>FuzzMap</h1>", unsafe_allow_html=True)

        # Campos de entrada
        usuario = st.text_input("Usuario", key="login_user")
        contraseña = st.text_input("Contraseña", type="password", key="login_pwd")
        if st.button("Iniciar Sesión", key="login_btn"):
            if autenticar_usuario(usuario, contraseña):
                st.session_state.user = usuario
                st.session_state.active_page = "🏠 Dashboard"
                st.success(f"¡Bienvenido, {usuario}!")
                st.rerun()
            else:
                st.error("Usuario o contraseña incorrectos.")

        # Enlace al registro con texto clicable
        if st.markdown(
            "<p>¿No tienes cuenta? <a href='#' id='to-register'>Regístrate aquí</a></p>",
            unsafe_allow_html=True
        ):
            # Detectar clics en registro (simular cambio de página)
            if st.session_state.get('to-register-click', False):
                st.session_state.active_page = '📝 Registro'
                st.rerun()

    with col2:
        # Botón deslizante arriba de la imagen
        st.markdown("<div style='display:flex; justify-content:flex-end; margin-bottom:10px;'>", unsafe_allow_html=True)
        st.write("Light")
        mode = st_toggle_switch(
            label="", key="theme_toggle",
            default_value=(st.session_state.theme == "dark"),
            inactive_color="#D3D3D3",
            active_color="#11567f",
            track_color="#29B5E8"
        )
        st.write("Dark")
        st.markdown("</div>", unsafe_allow_html=True)

        # Actualizar tema al cambiar el toggle
        nueva = "dark" if mode else "light"
        if nueva != st.session_state.theme:
            st.session_state.theme = nueva
            cambiar_tema(nueva)
            st.rerun()

        # Imagen decorativa justo debajo del toggle
        imagen = Image.open("Modulos/ui/src/Fondo_dark.png")
        st.image(imagen, use_container_width=True)

# --------------------------------------------------
# Resto de páginas (stubs)
def register_page(questions=None):
    st.title("📝 Registro de Usuario")
    # Implementar registro...

def dashboard_page(questions=None):
    st.title("🏠 Dashboard")

# ... test_page, history_page, settings_page, logout ...

# --------------------------------------------------
# Orquestador de la aplicación
def run_app(questions):
    
    # esto configura la página de Streamlit
    st.set_page_config(page_title = "FuzzMap", layout = "wide")
    
    # Inicializar session state
    if "user" not in st.session_state:
        st.session_state.user = None
    if "active_page" not in st.session_state:
        st.session_state.active_page = "Login"

    if st.session_state.user:
        # Navegar según active_page
        if st.session_state.active_page == "🏠 Dashboard":
            dashboard_page(questions)
        else:
            dashboard_page(questions)
    else:
        pagina_login(questions)

# Punto de entrada
questions = {"Demo": [("¿Qué es FuzzMap?", "Asistente inteligente de estudio")]}
run_app(questions)

